*.log
vgcore.*
core.[0-9]*
# Session journals hold raw meeting audio.  A stray copy in a repository is a
# data-protection problem, not just clutter.
*.jrn
*.pcm
# A live server config carries the two Bearer tokens in plain text.  The
# committed sample under tools/ deliberately has neither.
s2t-qt-server.conf
