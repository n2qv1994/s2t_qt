# systemd unit cho s2t-qt-server (Server buffer).
#
#   sudo install -m 644 tools/s2t-qt-server.service /etc/systemd/system/
#   sudo install -m 600 tools/s2t-qt-server.conf.sample /etc/s2t-qt-server.conf
#   sudo useradd --system --no-create-home --shell /sbin/nologin s2t
#   sudo systemctl daemon-reload && sudo systemctl enable --now s2t-qt-server
#   journalctl -u s2t-qt-server -f
#
# Binary mặc định ở /usr/local/bin, đúng chỗ `make install` của
# s2t-qt-server.pro đặt vào.

[Unit]
Description=s2t-qt-server (Server buffer cho hệ thống ASR + Diarization)
Documentation=file:/usr/local/share/doc/s2t-qt/luong-hoat-dong.md
# Chỉ là "sau khi có mạng", không phải "phụ thuộc": server vẫn khởi động được
# khi tầng suy luận chưa lên, và audio vẫn được nhận rồi xếp hàng - đó là điểm
# tồn tại của nó.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=s2t
Group=s2t
ExecStart=/usr/local/bin/s2t-qt-server --config /etc/s2t-qt-server.conf
# SIGTERM là đường tắt sạch sẽ: server dừng các luồng chuyển tiếp trước, để
# client nào đang chờ drain được trả lời thay vì bị cắt giữa chừng.
KillSignal=SIGTERM
# Một cuộc họp đang drain có thể mất vài chục giây để đẩy nốt hàng đợi lên
# tầng suy luận.  Đừng cắt ngắn hơn thế.
#
# Nếu có bật journal_dir thì việc bị cắt ngang cũng không mất audio - phần chưa
# gửi nằm trên đĩa và được đẩy nốt ở lần khởi động sau - nhưng để nó dừng gọn
# vẫn hơn.
TimeoutStopSec=90
Restart=on-failure
RestartSec=5

# Nhật ký ở mode=debug đi thẳng ra stdout, journald lo phần còn lại.
StandardOutput=journal
StandardError=journal

# Server không cần gì ngoài một socket và (nếu bật nhật ký) một thư mục ghi.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

# Bật hai dòng này để phiên sống sót qua lần khởi động lại, rồi đặt
#   journal_dir=/var/lib/s2t-qt-server
# trong /etc/s2t-qt-server.conf.  systemd tạo thư mục với đúng chủ sở hữu, và
# ProtectSystem=strict ở trên khiến đây là chỗ duy nhất dịch vụ ghi được.
#
# Nhớ chừa đĩa: mỗi phiên đang chờ giữ tối đa buffer/seconds giây audio
# (300 giây ≈ 28 MB), và journal_keep=session thì giữ cả cuộc họp.
#
# database/dir cũng ghi vào đây, và nó mới là thứ ăn đĩa về lâu dài: bản lưu
# giữ cuộc họp lại thay vì xoá đi, khoảng 115 MB audio mỗi giờ họp ở 16 kHz
# mono. Đặt cả hai dưới cùng một StateDirectory là được, chỉ cần khác thư mục
# con - đừng trỏ chúng vào cùng một chỗ, vì một bên xoá còn một bên giữ.
# StateDirectory=s2t-qt-server
# ReadWritePaths=/var/lib/s2t-qt-server

[Install]
WantedBy=multi-user.target
