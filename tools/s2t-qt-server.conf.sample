# Mẫu cấu hình cho s2t-qt-server (Server buffer).
#
# Chép sang /etc/s2t-qt-server.conf rồi sửa hai token.  Tệp thật chứa token
# dạng chữ thường, nên phải để quyền 600 và không đưa vào git - .gitignore đã
# chặn tên "s2t-qt-server.conf" vì lý do đó.
#
#   install -m 600 tools/s2t-qt-server.conf.sample /etc/s2t-qt-server.conf
#
# Mọi khoá ở đây đều có thể bị ghi đè bằng tham số dòng lệnh, và dòng lệnh
# luôn thắng.  Xem `s2t-qt-server --help`.

[listen]
# Nơi s2t-qt-client kết nối tới.  Để 127.0.0.1 nếu client chạy cùng máy.
address=0.0.0.0
port=8800
# Token mà client phải gửi kèm mọi lệnh gọi.  ĐỂ TRỐNG NGHĨA LÀ CHẤP NHẬN MỌI
# NGƯỜI GỌI TỚI ĐƯỢC CỔNG NÀY - server có cảnh báo lúc khởi động, nhưng nó vẫn
# chạy, nên đừng để trống trên mạng dùng chung.
token=
max_connections=128
# Một kênh RPC của client có thể nghỉ hết cả cuộc họp, nên giá trị này dài có
# chủ ý.
idle_timeout_ms=300000

[upstream]
# Tầng suy luận.  Chỉ Server buffer nói chuyện với địa chỉ này; client không
# bao giờ biết tới nó.
#
# Từ 2026-08-25 máy chủ nói THẲNG với tầng suy luận, không còn qua
# grpc_session_adapter.py nữa.  Có hai tầng, và `backend` quyết định `target`
# nghĩa là gì:
#
#   triton  inference.GRPCInferenceService (KServe v2), tức kho mô hình đang
#           chạy: asr_diar_session và mười mô hình phía sau nó.  Cổng gRPC của
#           Triton, KHÔNG phải cổng HTTP 8010.
#   riva    nvidia.riva.asr.RivaSpeechRecognition.  Cổng mặc định 50051.
#
# Gõ sai tên backend thì máy chủ TỪ CHỐI khởi động, chứ không chạy rồi trông
# như tầng suy luận không tới được - cùng lý do với bảng cờ dòng lệnh.
backend=triton
target=192.168.1.47:8011
token=

# Mô hình dùng để giải mã.  Để trống nghĩa là mặc định của backend; với Triton
# thì mặc định là asr_diar_session.
model=asr_diar_session

# Chỉ Riva dùng khoá này - với Triton thì kho mô hình đã hàm ý ngôn ngữ rồi.
language=vi-VN

timeout_ms=30000
probe_ms=5000

# KHÔNG CÒN DÙNG: `lanes`.  Nó cấp kênh cho các RPC chuyển tiếp, mà từ khi
# adapter biến mất thì không còn gì để chuyển tiếp - mọi RPC về một cuộc họp
# đều do chính máy chủ này trả lời.  Mỗi backend giữ đúng một kênh quản trị
# cho ping và danh sách mô hình.

[buffer]
# Mỗi phiên được giữ tối đa bấy nhiêu giây audio khi tầng suy luận chưa theo
# kịp.  Đây chính là thứ biến một sự cố mạng 5 phút thành độ sâu hàng đợi thay
# vì mất tiếng: 300 giây ở 48 kHz mono 16-bit là khoảng 28 MB RAM mỗi phiên.
# Đầy thì push_audio bị từ chối - có chủ ý, vì client được viết để dừng ồn ào
# chứ không im lặng bỏ audio.
seconds=300
# Nơi ghi nhật ký phiên.  ĐỂ TRỐNG LÀ TẮT, và khi tắt thì hàng đợi chỉ nằm
# trong RAM: khởi động lại máy chủ là mất mọi cuộc họp đang mở.
#
# Đặt vào đây thì mỗi gói audio được ghi xuống đĩa TRƯỚC khi client được ACK,
# nên một lần khởi động lại (nâng cấp, đổi cấu hình, hay tiến trình chết) chỉ
# tốn của client vài lần thử lại - thứ mà vòng thử lại của nó vốn đã chịu được
# - chứ không làm hỏng cuộc họp.  Máy chủ đọc lại thư mục này lúc khởi động,
# đẩy nốt phần chưa gửi lên tầng suy luận, rồi client ghi tiếp như chưa có gì.
#
# Cần quyền ghi cho user chạy dịch vụ.  Xem phần ReadWritePaths trong
# tools/s2t-qt-server.service.
#
# MỘT thư mục nhật ký chỉ được MỘT tiến trình dùng.  Hai máy chủ dùng chung sẽ
# cùng khôi phục một phiên và cùng gửi lại một gói, tức nhân đôi chữ trong bản
# chép.  Máy chủ giữ một khoá ở đây và từ chối khởi động nếu đã có ai giữ, kèm
# pid và tên máy trong thông báo lỗi.  Chạy hai instance trên cùng một máy thì
# mỗi cái một journal_dir.
journal_dir=

# Ghi tới đâu thì coi là an toàn để ACK cho client:
#   os    - write() đã trả về.  Chịu được tiến trình chết và máy chủ khởi động
#           lại (đúng thứ tính năng này sinh ra để lo), KHÔNG chịu được mất
#           điện đột ngột.  Mặc định.
#   fsync - fsync() đã trả về.  Chịu được cả mất điện, đổi lại mỗi gói tốn một
#           lần fsync (6 gói/giây mỗi phiên).
durability=os

# Phân đoạn nhật ký đã được tầng suy luận nhận hết thì làm gì:
#   queue   - xoá đi.  Dung lượng đĩa khi đó bám theo độ sâu hàng đợi, vốn đã
#             có trần; một phiên khoẻ mạnh chỉ giữ một hai phân đoạn.  Mặc định.
#   session - giữ tới khi quên hẳn phiên.  Nhật ký thành bản lưu của cả cuộc
#             họp, đổi lại tốn đĩa bằng đúng độ dài cuộc họp (~96 kB mỗi giây).
journal_keep=queue

# Kích thước một phân đoạn nhật ký, tính bằng byte.  16 MB ≈ 170 giây audio.
segment_bytes=16777216

# Phiên được khôi phục sau khi khởi động lại mà KHÔNG client nào quay lại nhận
# thì bị đóng sau bấy nhiêu giây (phần chưa gửi vẫn được đẩy lên trước khi
# đóng).  Không có mốc này thì một máy chủ khởi động lại vài lần sẽ tích lại
# những cuộc họp không bao giờ kết thúc.  0 là tắt.
orphan_timeout_sec=1800

# Tuổi tối đa của bộ nhớ đệm get_live_state.  Dưới ngưỡng này, mười client
# cùng xem một cuộc họp chỉ tốn của tầng suy luận đúng một lần hỏi.
state_poll_ms=200
# Giữ phiên đã dừng thêm bấy nhiêu giây để client còn đọc được trạng thái cuối
# và các bộ đếm.
finished_retention_sec=900

[log]
# debug ghi ra console, develop ghi ra tệp trong thư mục dữ liệu ứng dụng.
# Chạy dưới systemd thì để debug: journald đã lo phần lưu trữ.
mode=debug
level=info

